<mxfile host="app.diagrams.net">
  <diagram name="Junando AWS Architecture" id="junando-arch">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- AWS account boundary group -->
        <mxCell id="boundary" value="AWS account — junando stack" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=32;fontColor=#232F3E;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="50" width="720" height="670" as="geometry" />
        </mxCell>

        <!-- AWS-native service icons -->
        <mxCell id="webhook" value="Webhook&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6673&quot;&gt;Lambda · Function URL&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="308" y="362" width="64" height="64" as="geometry" />
        </mxCell>

        <mxCell id="worker" value="Worker&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6673&quot;&gt;Lambda · SQS trigger&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="788" y="362" width="64" height="64" as="geometry" />
        </mxCell>

        <mxCell id="queue" value="AlertQueue&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6673&quot;&gt;SQS FIFO&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="548" y="362" width="64" height="64" as="geometry" />
        </mxCell>

        <mxCell id="dlq" value="AlertDLQ&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6673&quot;&gt;SQS FIFO · failed msgs&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="548" y="582" width="64" height="64" as="geometry" />
        </mxCell>

        <mxCell id="ssm" value="Parameter Store&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6673&quot;&gt;SSM · provider secrets&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" vertex="1" parent="1">
