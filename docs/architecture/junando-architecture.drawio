        <mxCell id="dedup" value="DedupTable&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5b6673&quot;&gt;DynamoDB · fingerprint TTL&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="868" y="132" width="64" height="64" as="geometry" />
